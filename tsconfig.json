{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["chrome", "node"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "tests",
    "wxt.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
