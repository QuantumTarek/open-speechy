{
  "name": "open-speechy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "pnpm run copy:ort && wxt build",
    "build:test": "pnpm run copy:ort && node tools/build-test.mjs",
    "zip": "pnpm run build && wxt zip",
    "copy:ort": "node tools/copy-ort-assets.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm run build:test && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.2",
    "@mozilla/readability": "^0.6.0",
    "@wxt-dev/storage": "^1.1.1",
    "dompurify": "^3.2.6",
    "kokoro-js": "^1.2.1",
    "onnxruntime-web": "^1.22.0",
    "pdfjs-dist": "^5.4.149",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.0.326",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.18.6",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@wxt-dev/module-react": "^1.1.3",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "happy-dom": "^18.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4",
    "wxt": "^0.20.6"
  }
}
